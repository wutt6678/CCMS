# LLM Judge credentials template.
#
# Copy this file to `llm_judge_credentials.conf` in the same directory and
# fill in the real values. The credentials file is gitignored and must NEVER
# be committed.
#
#   cp llm_judge_credentials.conf.example llm_judge_credentials.conf
#
# Precedence: environment variables override this file.
#   LLM_JUDGE_API_KEY, LLM_JUDGE_BASE_URL, LLM_ADJUDICATOR_MODEL, etc.

# Required: the Aliyun MaaS API key (rotated credential).
LLM_JUDGE_API_KEY=REPLACE_WITH_ROTATED_KEY

# Optional: endpoint base URL (defaults to the Aliyun MaaS compatible-mode).
LLM_JUDGE_BASE_URL=https://llm-jhxtd03gjg0gd2o2.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Optional: override primary judge models (defaults below are used).
LLM_JUDGE_PRIMARY_A_MODEL=qwen3.8-max
LLM_JUDGE_PRIMARY_B_MODEL=glm-5.2

# Distinct adjudicator model (must differ from both primaries).
# kimi-k3 is distinct from qwen3.8-max and glm-5.2. Note: the gateway
# also lists "kimi/kimi-k3" but that product is not activated (400).
LLM_ADJUDICATOR_MODEL=kimi-k3
