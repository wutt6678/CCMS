# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Data — source data, media, and generated artifacts are NOT tracked
# ---------------------------------------------------------------------------
# Raw downloaded datasets (too large for GitHub)
data/raw/*
!data/raw/*/.gitkeep

# Downloaded / generated images
data/media/*
!data/media/*/.gitkeep
# The 20 Scale-B source images referenced by validated_families.jsonl are
# provenance-bound and MUST be tracked so the LLM-judge pipeline can rerun
# with the exact image bytes. Only these specific files are un-ignored.
!data/media/source/
data/media/source/*
!data/media/source/mtmcs_type_b_0_main.png
!data/media/source/mtmcs_type_b_3_main.png
!data/media/source/mtmcs_type_b_4_main.png
!data/media/source/mtmcs_type_b_6_main.png
!data/media/source/mtmcs_type_b_8_main.png
!data/media/source/mtmcs_type_b_17_main.png
!data/media/source/mtmcs_type_b_20_main.png
!data/media/source/mtmcs_type_b_22_main.png
!data/media/source/mtmcs_type_b_23_main.png
!data/media/source/mtmcs_type_b_34_main.png
!data/media/source/mtmcs_type_b_36_main.png
!data/media/source/mtmcs_type_b_40_main.png
!data/media/source/mtmcs_type_b_42_main.png
!data/media/source/mtmcs_type_b_44_main.png
!data/media/source/mtmcs_type_b_47_main.png
!data/media/source/mtmcs_type_b_52_main.png
!data/media/source/mtmcs_type_b_55_main.png
!data/media/source/mtmcs_type_b_57_main.png
!data/media/source/mtmcs_type_b_59_main.png
!data/media/source/mtmcs_type_b_60_main.png

# Generated family data
data/families/*
!data/families/*/.gitkeep
data/splits/*
!data/splits/.gitkeep
data/manifests/*
!data/manifests/.gitkeep

# Normalized data (may contain references to local paths)
data/normalized/*.jsonl
!data/normalized/.gitkeep

# ---------------------------------------------------------------------------
# Outputs
# ---------------------------------------------------------------------------
outputs/inference/*
!outputs/inference/.gitkeep
outputs/evaluation/*
!outputs/evaluation/.gitkeep
# Replay runs are tracked evidence; GPU-wait logs are not
outputs/replay_runs/*.log

# Keep schema reports (small, useful for reference)
# outputs/schema/ is tracked

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
*.log
.DS_Store
Thumbs.db
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# Hugging Face cache
.cache/

# Conda
.conda/

# Local CI-reproduction venv
.ci-venv/

# ---------------------------------------------------------------------------
# Secrets / credentials — NEVER tracked
# ---------------------------------------------------------------------------
configs/**/*credentials*
configs/**/*secret*
# ...but the credential TEMPLATE (no real values) is tracked for reference.
!configs/evaluation/llm_judge_credentials.conf.example
*.key
.env

# Transient judge-run checkpoints (resume state, never evidence)
outputs/**/*checkpoint*.json
